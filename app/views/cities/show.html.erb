<h4>Ville : <%= @city.name %></h4>

<h2>Potins de la ville</h2>
<br>
<div class="row g-4">
  <% @city.users.each do |user| %>
    <% user.gossips.each do |gossip| %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <%= link_to gossip.title, gossip_path(gossip), class: "text-decoration-underline text-dark" %>
            </h5>
            <h6 class="card-subtitle mb-2 text-muted">par <%= user.first_name %></h6>
            <p class="card-text text-secondary">📍 <%= @city.name %></p>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
<br>
<hr>
  <%= link_to "Retour à l'accueil", root_path, class: "return-link" %>
<hr>