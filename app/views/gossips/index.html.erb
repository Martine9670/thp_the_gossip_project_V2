<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="card-title mb-4 text-center">Liste des potins</h4>

          <div class="row g-4">
            <% @gossips.each do |gossip| %>
              <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                  <div class="card-body">
                    <h6 class="card-title">
                      <%= link_to gossip.title, gossip_path(gossip), class: "text-decoration-none" %>
                    </h6>
                    <h6 class="card-subtitle mb-2 text-muted">
                      par <%= gossip.user.first_name if gossip.user %>
                    </h6>
                    <p class="card-text text-secondary">
                      💬 <strong><%= gossip.comments.count %></strong> commentaire<%= "s" if gossip.comments.count > 1 %>
                    </p>

                    <% if gossip.user == current_user %>
                      <%= link_to 'Supprimer', gossip_path(gossip), method: :delete, data: { confirm: "Tu es sûr de vouloir supprimer ce potin ?" }, class: "btn btn-sm btn-danger" %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <hr>

          <%= link_to "Retour à l'accueil", root_path, class: "return-link d-block text-center mt-3" %>
        </div> <!-- .card-body -->
      </div> <!-- .card -->
    </div> <!-- .col -->
  </div> <!-- .row -->
</div> <!-- .container -->
