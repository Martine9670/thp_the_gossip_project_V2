<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="card-title mb-4 text-center">Créer un nouveau potin</h4>

          <%= form_with model: @gossip, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :title, "Titre", class: "form-label fw-bold" %>
              <%= f.text_field :title, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :content, "Contenu", class: "form-label fw-bold" %>
              <%= f.text_area :content, class: "form-control", rows: 5 %>
            </div>

            <div class="mb-3">
              <%= f.label :tag_ids, "Choix du tag", class: "form-label fw-semibold mb-2" %>
              <%= f.collection_select :tag_ids, Tag.all, :id, :title, { multiple: true }, class: "form-select w-50", size: 5 %>
            </div>
         <hr>
            <%= f.submit "✏️ Créer", class: "btn btn-info w-100" %>
          <% end %>
         <hr>

          <%= link_to "Retour à l'accueil", root_path, class: "return-link d-block text-center mt-3" %>
        </div> <!-- .card-body -->
      </div> <!-- .card -->
    </div> <!-- .col -->
  </div> <!-- .row -->
</div> <!-- .container -->
