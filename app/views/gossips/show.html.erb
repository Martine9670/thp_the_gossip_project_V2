<h2><%= @gossip.title %></h2>

<p><strong>Auteur :</strong> 
  <%= link_to @gossip.user.first_name, user_path(@gossip.user) %>
</p>

<p><strong>Ville de l'auteur :</strong> 
  <%= link_to @gossip.user.city.name, city_path(@gossip.user.city) if @gossip.user.city %>
</p>

<div class="card mb-3">
  <div class="card-body ps-3">
    <p><strong><u>Contenu</u> :</strong></p>
    <p><%= @gossip.content %></p>
    <p class="text-muted"><em>Créé le <%= @gossip.created_at.strftime("%d/%m/%Y à %H:%M") %></em></p>

    <div class="d-flex gap-2">
      <%= link_to "Modifier ce potin", edit_gossip_path(@gossip), class: "btn btn-warning" %>
      <%= button_to "Supprimer ce potin", gossip_path(@gossip), 
                    method: :delete, 
                    data: { turbo_confirm: "Es-tu sûr de vouloir supprimer ce potin ?" }, 
                    class: "btn btn-danger" %>
      <hr>
      <p1>
        <strong>Nombre de commentaires :</strong> 
        <span class="badge bg-primary"><%= @gossip.comments.count %></span>
      </p1>

    </div>
  </div>
</div>

  <%= link_to "Retour à l'accueil", root_path %>


<hr>
<h3>Commentaires :</h3>

<% if @gossip.comments.any? %>
<% @gossip.comments.each do |comment| %>
  <div style="border: 1px solid red; padding: 10px; margin-bottom: 10px;">
    <p><strong>Contenu :</strong> <%= comment.content %></p>
    <p><strong>créé le :</strong> <%= comment.created_at.strftime("%d/%m/%Y à %H:%M") %></em></p>

  <div>
    <%= link_to "Modifier", edit_gossip_comment_path(@gossip, comment), class: "btn btn-warning" %>
    <%= button_to "Supprimer", gossip_comment_path(@gossip, comment), method: :delete, data: { "turbo-confirm": "Supprimer ce commentaire ?" }, class: "btn btn-outline-danger btn-sm" %>
  </div>
  </div>
<% end %>
  <% else %>
    <p>Aucun commentaire pour l'instant.</p>
  <% end %>

<hr>
<h3>Ajouter un commentaire</h3>

<%= form_with(model: [@gossip, Comment.new], local: true) do |form| %>
  <div>
    <%= form.text_area :content, placeholder: "Votre commentaire ici...", rows: 3 %>
  </div>
  <div>
    <%= form.submit "Envoyer", class: "btn btn-primary" %>
    </div>


<% end %>





<!--
EXPLICATIONS :

1. <%= @gossip.title %>
   - Affiche le titre du potin courant (@gossip).

2. <%= link_to @gossip.user.first_name, user_path(@gossip.user) %>
   - Crée un lien avec le prénom de l’auteur du potin.
   - Le lien mène vers la page de cet utilisateur.

3. <%= @gossip.content %>
   - Affiche le contenu du potin.

4. <%= @gossip.created_at.strftime("%d/%m/%Y à %H:%M") %>
   - Affiche la date et l’heure de création formatée en "jour/mois/année à heure:minute".

5. <%= link_to "Retour à l'accueil", root_path %>
   - Lien pour revenir à la page d’accueil du site.
-->
