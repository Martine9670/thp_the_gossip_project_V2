<div class="title2 mb-3">
  <h5><%= @gossip.title %></h5>
</div>

<div class="potin mb-3">
  <p><strong>Auteur :</strong> 
    <%= link_to @gossip.user.first_name, user_path(@gossip.user), class: "city-link" %>
  </p>

  <p><strong>Ville de l'auteur :</strong> 
    <%= link_to @gossip.user.city.name, city_path(@gossip.user.city), class: "city-link" if @gossip.user.city %>
  </p>
</div>


<div class="card mb-3">
  <div class="card-body ps-3">
    <% if @gossip.tags.any? %>
      <p><strong>Tags associés :</strong></p>
      <div class="mb-3">
        <% @gossip.tags.each do |tag| %>
          <%= link_to tag.title, tag_path(tag), class: "badge bg-info text-dark me-1 text-decoration-none" %>
        <% end %>
      </div>
    <% end %>

    <p><strong><u>Contenu</u> :</strong></p>
    <p><%= @gossip.content %></p>
    <p class="text-muted"><em>Créé le : <%= @gossip.created_at.strftime("%d/%m/%Y à %H:%M") %></em></p>
    <p><strong>Likes :</strong> <%= @gossip.likes.count %></p>

    <% if logged_in? %>
      <% if current_user.liked?(@gossip) %>
        <%= button_to "Unlike", gossip_like_path(@gossip, current_user.likes.find_by(likeable: @gossip)), method: :delete, class: "btn btn-outline-danger btn-sm" %>
      <% else %>
        <%= button_to "Like", gossip_likes_path(@gossip), method: :post, class: "btn btn-primary btn-sm" %>
      <% end %>
    <% else %>
      <p><%= link_to "Connectez-vous pour liker", login_path %></p>
    <% end %>
    <hr>

    <div class="d-flex gap-2">
      <% if current_user == @gossip.user %>
      <%= link_to "Modifier ce potin", edit_gossip_path(@gossip), class: "btn btn-info btn-sm" %>
      <%= button_to "Supprimer ce potin", gossip_path(@gossip), 
          method: :delete, 
          data: { turbo: false },
          onclick: "return confirm('Supprimer ce potin ?')", 
          class: "btn btn-danger btn-sm" %>
      <% end %>
      <p1>
        <strong>Commentaires :</strong> 
        <span class="badge bg-primary"><%= @gossip.comments.count %></span>
      </p1>
    </div>
  </div>
</div>

<h5>💬 Commentaires :</h5>

<% if @gossip.comments.any? %>
<% @gossip.comments.each do |comment| %>
  <div class="potin-box">
    <p><strong>Contenu :</strong> <%= comment.content %></p>
    <p><strong>Auteur :</strong> <%= comment.user.first_name if comment.user %></p>
    <p><strong>Créé le :</strong> <%= comment.created_at.strftime("%d/%m/%Y à %H:%M") %></em></p>

    <div class="d-flex gap-2">
      <% if current_user == comment.user %>
      <%= link_to "Modifier votre commentaire", edit_gossip_comment_path(@gossip, comment), class: "btn purple btn-sm" %>
      <%= button_to "Supprimer votre commentaire", gossip_comment_path(@gossip, comment), 
          method: :delete, 
          data: { turbo: false },
          onclick: "return confirm('Supprimer ce commentaire ?')",          
          class: "btn btn-danger btn-sm" %>
      <% end %>
    </div>
  </div>
<% end %>
  <% else %>
    <p>Aucun commentaire pour l'instant...</p>
  <% end %>

<h5>📝 Ajouter un commentaire :</h5>

<%= form_with(model: [@gossip, Comment.new], local: true) do |form| %>
  <div>
    <%= form.text_area :content, placeholder: "Votre commentaire ici...", rows: 2 %>
  </div>
  <div>
    <%= form.submit "Envoyer", class: "btn btn-primary" %>
  </div>
<% end %>

<hr>
  <%= link_to "Retour à l'accueil", root_path, class: "return-link" %>
