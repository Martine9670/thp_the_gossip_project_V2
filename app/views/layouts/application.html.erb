<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "The Gossip Project V2" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Bootstrap CSS via CDN (chargé en premier) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" 
          rel="stylesheet" 
          integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" 
          crossorigin="anonymous">

    <!-- Ton CSS personnalisé (chargé après Bootstrap pour pouvoir surcharger les styles si besoin) -->
      <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
      <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <header class="bg-dark p-3 mb-4">
      <nav class="container d-flex justify-content-between align-items-center">
        <h1 class="h1 m-0">The Gossip Project</h1>
        <div>
          <%= link_to 'Accueil', root_path, class: 'text-white me-3' %>
          <%= link_to 'Team', team_path, class: 'text-white me-3' %>
          <%= link_to 'Contact', contact_path, class: 'text-white me-3' %>


          <% if logged_in? %>
            <%= link_to 'Messages reçus', messages_path, class: 'btn btn-info btn-sm' %>
            <%= link_to 'Messages envoyés', sent_messages_path, class: 'btn btn-potin btn-sm' %>
            <%= link_to 'Mon Compte', user_path(current_user), class: 'btn btn-info btn-sm' %> 

            <span class="text-white me-3"><br>Bonjour <%= current_user.first_name %> !</span>
            <%= button_to "Déconnexion", session_path, method: :delete, class: "btn btn-potin btn-sm" %>
          <% else %>
            <%= link_to "Connexion", new_session_path, class: "btn btn-info btn-sm me-3" %>
            <%= link_to "Inscription", new_user_path, class: "btn btn-potin btn-sm me-3" %>

          <% end %>
        </div>
      </nav>
    </header>

    <main class="container flex-grow-1">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == "notice" ? "success" : "danger" %> alert-dismissible fade show" role="alert">
          <%= message %>
        </div>
      <% end %>      
    <%= yield %>
    </main>
 
    <footer class="bg-secondary text-light py-1 mt-auto">
      <div class="container text-center">
        <small>© 2025 - LES 3 MOUSSAILONS - The Gossip Project - Tous droits réservés.</small><br>
        <small>Contact : <a href="mailto:contact@thegossipproject.com" class="text-light text-decoration-underline">contact@thegossipproject.com</a></small>
      </div>
    </footer>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        setTimeout(() => {
          document.querySelectorAll('.alert').forEach(el => {
            el.classList.remove('show');
            setTimeout(() => el.remove(), 300); // attends la fin de l'animation
          });
        }, 5000); // 5 secondes
      });
    </script>
  </body>
</html>
