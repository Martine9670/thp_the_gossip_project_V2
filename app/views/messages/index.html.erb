<h1>Messages reçus</h1>

<% if @received_messages.any? %>
  <ul class="list-group">
    <% @received_messages.each do |msg| %>
      <li class="list-group-item">
        <strong>De :</strong> <%= msg.sender.first_name %> <br>
        <strong>Reçu le :</strong> <%= msg.created_at.strftime("%d/%m/%Y %H:%M") %> <br>
        <p><%= msg.content %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Vous n'avez aucun message reçu.</p>
<% end %>

<%= link_to "Messages envoyés", sent_messages_path, class: "btn btn-info mt-3" %>
<%= link_to "Nouveau message", new_message_path, class: "btn btn-potin mt-3 ms-2" %>
