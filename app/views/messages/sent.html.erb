<h2>Messages envoyés</h2>

<% if @sent_messages.any? %>
  <ul class="list-group">
    <% @sent_messages.each do |msg| %>
      <li class="list-group-item">
        <strong>À :</strong>
        <%= msg.recipients.map { |r| r.first_name }.join(", ") %> <br>
        <strong>Envoyé le :</strong> <%= msg.created_at.strftime("%d/%m/%Y %H:%M") %> <br>
        <p><%= msg.content %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Vous n'avez envoyé aucun message.</p>
<% end %>

<%= link_to "Messages reçus", messages_path, class: "btn btn-info mt-3" %>
<%= link_to "Nouveau message", new_message_path, class: "btn btn-potin mt-3 ms-2" %>
