<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="card-title mb-4 text-center">Connexion</h4>
          <%= form_with url: session_path, method: :post, local: true do %>
            <div class="card p-2 mb-3">
              <%= label_tag :email %><br>
              <%= text_field_tag :email, nil, required: true %>
            </div>

            <div class="card p-2 mb-3">
              <%= label_tag :password %><br>
              <%= password_field_tag :password, nil, required: true, minlength: 8, placeholder: "Minimum 8 caractères" %>
            </div>

            <%= submit_tag "Se connecter", class: "btn btn-info w-100" %>
          <% end %>
        </div> <!-- .card-body -->
      </div> <!-- .card -->
    </div> <!-- .col-md-6 -->
  </div> <!-- .row -->
</div> <!-- .container -->
