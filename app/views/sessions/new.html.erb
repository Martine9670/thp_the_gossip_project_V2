<h4>Connexion</h4>
<br>

<%= form_with url: login_path, method: :post, local: true do %>
  <div>
    <%= label_tag :email %><br>
    <%= text_field_tag :email %>
  </div>

  <div>
    <%= label_tag :password %><br>
    <%= password_field_tag :password %>
  </div>
<br>
<%= submit_tag "Se connecter", class: "btn-login" %>
<% end %>
