<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="card-title mb-4 text-center">Connexion</h4>

          <% if flash[:alert] %>
            <div class="alert alert-danger">
              <%= flash[:alert] %>
            </div>
          <% end %>

          <%= form_with url: session_path, method: :post, local: true do %>
            <div class="card p-2 mb-3">
              <%= label_tag :email, "Email" %><br>
              <%= text_field_tag :email, nil, required: true, class: "form-control" %>
            </div>

            <div class="card p-2 mb-3">
              <%= label_tag :password, "Mot de passe" %><br>
              <%= password_field_tag :password, nil, required: true, minlength: 8, placeholder: "Minimum 8 caractères", class: "form-control" %>
            </div>

            <div class="form-check mb-3">
              <%= check_box_tag :remember_me, 1, false, class: "form-check-input" %>
              <%= label_tag :remember_me, "Se souvenir de moi", class: "form-check-label" %>
            </div>

            <%= submit_tag "Se connecter", class: "btn btn-info w-100" %>
          <% end %>
        </div> <!-- .card-body -->
      </div> <!-- .card -->
    </div> <!-- .col-md-6 -->
  </div> <!-- .row -->
</div> <!-- .container -->
