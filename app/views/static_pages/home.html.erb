<div class="mb-4 d-flex gap-2">
  <%= link_to "Nouveau Potin", new_gossip_path, class: "btn btn-info" %>
  <%= link_to "Voir tous les utilisateurs", users_path, class: "btn btn-info" %>
  <%= link_to "Inscription", new_user_path, class: "btn btn-info" %>

<p class="potin-count">Nombre de potins : <%= @gossips.count %></p>
<br>
<%= link_to "Voir tous les potins", gossips_path, class: "btn btn-potin" %>
</div>



<div class="container my-4">
  <h1 class="welcome">Bienvenue sur The Gossip Project !</h1>

  <div class="row">
    <% @gossips.each do |gossip| %>
      <div class="col-md-3 mb-2">
        <div class="card h-100">
          <div class="card-body">
            <h6 class="card-title"><%= gossip.title %></h6>
            <p class="card-text">
              <strong>Auteur :</strong>
              <%= link_to gossip.user.first_name, user_path(gossip.user), class: 'text-decoration-none' %>
            </p>
            <%= link_to "Voir le potin", gossip_path(gossip), class: "btn btn-outline-danger" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>


