<h4>Potins avec le tag : <%= @tag.title %></h4>
<br>

<div class="d-flex flex-wrap gap-3">
  <% if @gossips.any? %>
    <% @gossips.each do |gossip| %>
      <div class="card shadow-sm" style="width: 250px;">
        <div class="card-body">
          <h5 class="card-title"><%= gossip.title %></h5>
          <p class="card-text"><%= gossip.content.truncate(100) %></p>
          <%= link_to 'Voir ce potin', gossip_path(gossip), class: 'btn btn-info btn-sm' %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-muted fst-italic">Aucun potin avec ce tag pour l’instant...</p>
  <% end %>
</div>
<hr>
  <%= link_to "Retour à l'accueil", root_path, class: "return-link" %>
<hr>