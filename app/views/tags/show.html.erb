<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="card-title mb-4 text-center">Potins avec le tag : <%= @tag.title %></h4>

          <% if @gossips.any? %>
            <div class="row g-4">
              <% @gossips.each do |gossip| %>
                <div class="col-md-6 col-lg-4">
                  <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                      <h5 class="card-title"><%= gossip.title %></h5>
                      <p class="card-text flex-grow-1"><%= gossip.content.truncate(100) %></p>
                      <%= link_to 'Voir ce potin', gossip_path(gossip), class: 'btn btn-info btn-sm mt-auto' %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted fst-italic text-center">Aucun potin avec ce tag pour l’instant...</p>
          <% end %>

          <hr>
          <%= link_to "Retour à l'accueil", root_path, class: "return-link d-block text-center mt-3" %>
        </div> <!-- .card-body -->
      </div> <!-- .card -->
    </div> <!-- .col -->
  </div> <!-- .row -->
</div> <!-- .container -->
