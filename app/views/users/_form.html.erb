<%= form_with model: user, local: true do |form| %>
  <% if user.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(user.errors.count, "erreur") %> Échec de la sauvegarde:</h4>
      <ul>
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :first_name %><br>
    <%= form.text_field :first_name, autocomplete: "given-name" %>
  </div>
  <div>
    <%= form.label :last_name %><br>
    <%= form.text_field :last_name, autocomplete: "family-name" %>
  </div>
  <div>
    <%= form.label :description %><br>
    <%= form.text_area :description, rows: 4, placeholder: "Présente-toi en quelques mots..." %>
  </div>
  <div>
    <%= form.label :age %><br>
    <%= form.number_field :age, min: 0, max: 150, placeholder: "Votre âge" %>
  </div>
  <div>
    <%= form.label :city_id, "Ville" %><br>
    <%= form.collection_select :city_id, City.all, :id, :name, prompt: "Choisissez une ville", autocomplete: "address-level2" %>
  </div>
  <div>
    <%= form.label :email %><br>
    <%= form.email_field :email, autocomplete: "email" %>
  </div>

  <%# Affiche les champs mot de passe uniquement si l’utilisateur n’existe pas (création) %>
  <% if user.new_record? %>
    <div>
      <%= form.label :password %><br>
      <%= form.password_field :password, autocomplete: "new-password" %>
    </div>
    <div>
      <%= form.label :password_confirmation %><br>
      <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>
  <% end %>
<br>
  <div>
    <%= form.submit user.new_record? ? "🔒 S'inscrire" : "💾 Mettre à jour", class: "btn btn-info" %>
  </div>
  <hr>
<% end %>

  <%= link_to "Retour à l'accueil", root_path, class: "return-link" %>
<hr>

