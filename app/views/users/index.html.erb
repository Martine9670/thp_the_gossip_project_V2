<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="card-title mb-4 text-center">Liste des utilisateurs</h4>

          <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
            <% @users.each do |user| %>
              <div class="col">
                <div class="card h-100 shadow-sm">
                  <div class="card-body position-relative">
                    <h5 class="card-title">
                      <%= link_to user.first_name, user_path(user), class: "stretched-link text-decoration-none" %>
                    </h5>
                    <p class="card-text"><%= truncate(user.description || "Pas de description", length: 140) %></p>
                    <p>
                      <strong>Nombre de potins :</strong>
                      <span class="badge bg-primary"><%= user.gossips.count %></span>
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <hr>

          <%= link_to "Retour à l'accueil", root_path, class: "return-link d-block text-center mt-3" %>
        </div> <!-- .card-body -->
      </div> <!-- .card -->
    </div> <!-- .col -->
  </div> <!-- .row -->
</div> <!-- .container -->
