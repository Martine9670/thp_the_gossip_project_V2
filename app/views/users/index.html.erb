<h4>Liste des utilisateurs</h4>
<br>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
  <% @users.each do |user| %>
    <div class="col">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title"><%= link_to user.first_name, user_path(user), class: "stretched-link text-decoration-none" %></h5>
          <p class="card-text"><%= truncate(user.description, length: 140) %></p>
            <p>
               <strong>Nombre de potins :</strong> 
               <span class="badge bg-primary"><%= user.gossips.count %></span>
            </p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<hr>
  <%= link_to "Retour à l'accueil", root_path, class: "return-link" %>
<hr>
