<div class="profile-card">
  <div class="profile-header">
    <h4>🪪 <%= @user.first_name %> <%= @user.last_name %></h4>
  </div>

  <div class="profile-body">
    <p><strong>📝 Description :</strong> <%= @user.description %></p>
    <p><strong>🎂 Âge :</strong> <%= @user.age ? "#{@user.age} ans" : "Non renseigné" %></p>
    <p><strong>📧 Email :</strong> <%= @user.email %></p>
    <p><strong>📍 Ville :</strong> 
      <%= link_to @user.city.name, city_path(@user.city), class: "city-link" if @user.city %>
    </p>
  </div>
</div>

<div>
  <% if current_user == @user %>
    <div class="d-flex gap-5">
      <%= link_to "Modifier mon profil", edit_user_path(@user), class: "btn btn-potin" %>
      
      <%= button_to "Supprimer mon profil", user_path(@user), 
        method: :delete, 
        data: { turbo: false },
        onclick: "return confirm('Supprimer votre profil ?')",          
        class: "btn btn-danger" %>
    </div>
  <% end %>
</div>

  <hr>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="card-title mb-4 text-center">Ses potins :</h4>

          <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% @user.gossips.each do |gossip| %>
              <div class="col">
                <div class="card h-100 shadow-sm">
                  <div class="card-body">
                    <h5 class="card-title"><%= gossip.title %></h5>
                    <p class="card-text"><%= gossip.content.truncate(100) %></p>
                    <%= link_to 'Voir ce potin', gossip_path(gossip), class: 'btn btn-info' %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
<hr>
  <%= link_to "Retour à l'accueil", root_path, class: "return-link" %>
<hr>

        </div> <!-- card-body -->
      </div> <!-- card -->
    </div> <!-- col -->
  </div> <!-- row -->
</div> <!-- container -->



